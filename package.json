{
  "name": "deepa-inventory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "node node_modules/.bin/tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "test": "node node_modules/.bin/vitest run",
    "typecheck": "node node_modules/.bin/tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.1",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@modelcontextprotocol/server-everything": "^2.2.1",
    "@modelcontextprotocol/server-filesystem": "^2.2.0",
    "@modelcontextprotocol/server-memory": "^2.1.0",
    "@modelcontextprotocol/server-sequential-thinking": "^2.1.1",
    "@playwright/mcp": "^0.0.84",
    "@transcend-io/mcp-server-inventory": "^1.0.19",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "barcode-scanner-mcp": "^1.2.0",
    "catalog-mcp": "^0.1.0",
    "concurrently": "^9.1.0",
    "git-repo-explorer-mcp": "^0.1.1",
    "puppeteer": "^25.16.0",
    "shopops-mcp-server": "^1.2.4",
    "test-inventory-mcp": "^0.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.5"
  },
  "allowScripts": {
    "esbuild": true
  }
}
